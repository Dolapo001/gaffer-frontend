# Gaffer API Configuration
# Copy this file to .env.local and fill in your values

# Base URL of the Gaffer backend (no trailing slash, no /api prefix)
# All paths are root-relative e.g. /auth/login
NEXT_PUBLIC_API_URL=http://localhost:3001

# App URL (used for PWA and meta tags)
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Google OAuth
# Get this from: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# ─── Removed ──────────────────────────────────────────────────────────────────
# Firebase configuration has been removed.
# Authentication is now JWT Bearer token + HttpOnly refresh cookie.
# See lib/api.ts and lib/services/auth.service.ts for implementation.
